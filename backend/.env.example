ANTHROPIC_API_KEY=your_api_key_here
PORT=3001

# Shared team login. Generate APP_PASSWORD_HASH with:
#   node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
APP_PASSWORD_HASH=
# Random signing secret for login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Locked out? Break-glass administrator recovery ---
# Set BOTH of these and restart. On boot the account is created (or its password reset),
# made a platform administrator, and given Admin rights on the first organization.
# Then REMOVE them and restart again — leaving them set re-applies on every boot.
ADMIN_RESET_EMAIL=
ADMIN_RESET_PASSWORD=

# --- Optional: Cloudflare R2 object storage for uploaded files ---
# Leave these blank to keep files in the database (default). Set all four to store
# uploads in R2 instead — then run: node scripts/migrate-blobs-to-r2.js
# Endpoint looks like https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
